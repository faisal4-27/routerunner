# Copy this file to `backend/.env` and adjust as needed.
# Every value here has a safe default in code, so the .env is optional for
# local development — it just lets you swap endpoints without editing source.
#
# IMPORTANT: never commit your real .env. The repo's .gitignore keeps it out.

# OSRM routing server (pedestrian "foot" profile).
# The public demo is fine for low traffic; host your own for production.
OSRM_BASE_URL=https://router.project-osrm.org

# Community Overpass API (no key required, fair-use rate limits apply).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Overpass rejects generic httpx/Python user-agents — set something
# identifying your deployment.
OVERPASS_USER_AGENT=RouteRunner/1.0 (contact: you@example.com)

# Open-Meteo elevation (no key required).
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# Suppress Python bytecode caching everywhere (no __pycache__ folders).
PYTHONDONTWRITEBYTECODE=1

# Comma-separated list of browser origins allowed to call the API.
# Add your deployed frontend domain alongside the local dev origins.
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Backend port. Most PaaS providers (Render, Fly.io, Railway) inject PORT
# themselves; this default only matters when you run `python run.py` locally.
PORT=8000
